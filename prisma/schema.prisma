generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model CivicReport {
  id          String   @id @default(uuid())
  userId      String
  description String
  latitude    Float
  longitude   Float
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
}

model CheckpostPass {
  id          String   @id @default(uuid())
  userId      String
  corridor    String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}